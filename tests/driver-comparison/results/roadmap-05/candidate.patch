diff --git a/internal/protocol/request_scratch.go b/internal/protocol/request_scratch.go
new file mode 100644
index 0000000..cdc391d
--- /dev/null
+++ b/internal/protocol/request_scratch.go
@@ -0,0 +1,122 @@
+// Copyright 2026 The Gocql Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+
+package protocol
+
+import (
+	"encoding/binary"
+	"math"
+
+	frm "github.com/scylladb/gocql/v2/internal/frame"
+	"github.com/scylladb/gocql/v2/internal/model"
+	"github.com/scylladb/gocql/v2/internal/wire"
+)
+
+// SmallTypedRequestSize selects native prepared frames that can be encoded in
+// transport-owned scalar scratch. Canonical value spans stay borrowed. Complex
+// and large requests keep their
+// immutable segmented representation. Invalid scalar options are left to the
+// canonical encoder so their established validation order remains unchanged.
+func (c Settings) SmallTypedRequestSize(r *model.AttemptRequest, limit int) (int, bool) {
+	if c.Protocol < 3 || c.Protocol > 4 || c.Compression != "" || r.Prepare || r.Batch != nil || len(r.PreparedID) == 0 || len(r.Payload) > 0 || r.Keyspace != "" || r.NowInSeconds != nil || r.ValueCount < 0 || r.ValueCount > math.MaxUint16 || len(r.PreparedID) > math.MaxUint16 || len(r.ResultMetadataID) > math.MaxUint16 || r.PageSize < 0 || int64(r.PageSize) > math.MaxInt32 {
+		return 0, false
+	}
+	size := int64(HeadSize + 2 + len(r.PreparedID) + 3)
+	if c.MetadataID {
+		size += int64(2 + len(r.ResultMetadataID))
+	}
+	if r.ValueCount > 0 {
+		size += 2 + r.Values.Len()
+	}
+	if r.PageSize > 0 {
+		size += 4
+	}
+	if r.PagingState != nil {
+		size += 4 + int64(len(r.PagingState))
+	}
+	if r.SerialConsistency != 0 {
+		size += 2
+	}
+	if r.DefaultTimestamp {
+		size += 8
+	}
+	if c.TabletsRoutingV2 {
+		size++
+	}
+	if size > int64(limit) || size < HeadSize {
+		return 0, false
+	}
+	parts := 0
+	if err := r.Values.Each(func(wire.Span) error {
+		parts++
+		if parts > 8 {
+			return wire.ErrBounds
+		}
+		return nil
+	}); err != nil {
+		return 0, false
+	}
+	return int(size), true
+}
+
+// BuildSmallTypedRequest borrows dst until the caller's accepted writer has
+// completed. It must never back a publicly retained frame. Transport uses the
+// size predicate first; all bound values retain canonical validation here.
+func (c Settings) BuildSmallTypedRequest(r *model.AttemptRequest, stream int, dst []byte) (wire.Chain, error) {
+	size, ok := c.SmallTypedRequestSize(r, cap(dst))
+	if !ok {
+		return c.BuildTypedRequest(r, stream)
+	}
+	if err := validateTypedValues(r.Values, r.ValueCount, c.Protocol); err != nil {
+		return wire.Chain{}, err
+	}
+	if int64(size-HeadSize) > c.MaxFrameBytes {
+		return wire.Chain{}, ErrFrameTooBig
+	}
+	out := dst[:0]
+	flags := c.Flags & frm.FlagBetaProtocol
+	if r.Trace {
+		flags |= frm.FlagTracing
+	}
+	out = append(out, c.Protocol, flags)
+	out = binary.BigEndian.AppendUint16(out, uint16(stream))
+	out = append(out, byte(frm.OpExecute))
+	out = binary.BigEndian.AppendUint32(out, uint32(size-HeadSize))
+	out = binary.BigEndian.AppendUint16(out, uint16(len(r.PreparedID)))
+	out = append(out, r.PreparedID...)
+	if c.MetadataID {
+		out = binary.BigEndian.AppendUint16(out, uint16(len(r.ResultMetadataID)))
+		out = append(out, r.ResultMetadataID...)
+	}
+	out = binary.BigEndian.AppendUint16(out, uint16(r.Consistency))
+	out = append(out, byte(typedParameterFlags(r, false)))
+	if r.ValueCount > 0 {
+		out = binary.BigEndian.AppendUint16(out, uint16(r.ValueCount))
+	}
+	prefixEnd := len(out)
+	if r.PageSize > 0 {
+		out = binary.BigEndian.AppendUint32(out, uint32(r.PageSize))
+	}
+	if r.PagingState != nil {
+		out = binary.BigEndian.AppendUint32(out, uint32(len(r.PagingState)))
+		out = append(out, r.PagingState...)
+	}
+	if r.SerialConsistency != 0 {
+		out = binary.BigEndian.AppendUint16(out, uint16(r.SerialConsistency))
+	}
+	if r.DefaultTimestamp {
+		out = binary.BigEndian.AppendUint64(out, uint64(r.Timestamp))
+	}
+	if c.TabletsRoutingV2 {
+		out = append(out, r.TabletVersionBlock)
+	}
+	// Prefix and suffix share only owned framing storage. Preserve all canonical
+	// input spans, including small blobs, through the original writer boundary.
+	var parts [10]wire.Span
+	spans := append(parts[:0], wire.Borrow(out[:prefixEnd]))
+	if r.ValueCount > 0 {
+		_ = r.Values.Each(func(s wire.Span) error { spans = append(spans, s); return nil })
+	}
+	spans = append(spans, wire.Borrow(out[prefixEnd:]))
+	return wire.NewChain(spans...)
+}

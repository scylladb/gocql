index 0000000..fc7073f
--- /dev/null
+++ b/internal/transport/v2_request_scratch.go
@@ -0,0 +1,54 @@
+// Copyright 2026 The Gocql Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+
+package transport
+
+import (
+	"context"
+	"github.com/scylladb/gocql/v2/internal/wire"
+)
+
+// At most 16 KiB of idle small-frame bytes are retained across the driver.
+// In-flight storage belongs to one accepted writer and is never shared.
+type smallTypedFrame struct{ data [256]byte }
+
+var smallTypedFrames = make(chan *smallTypedFrame, 64)
+
+func acquireSmallTypedFrame() *smallTypedFrame {
+	select {
+	case p := <-smallTypedFrames:
+		return p
+	default:
+		return new(smallTypedFrame)
+	}
+}
+func releaseSmallTypedFrame(p *smallTypedFrame) {
+	if p == nil {
+		return
+	}
+	clear(p.data[:])
+	select {
+	case smallTypedFrames <- p:
+	default:
+	}
+}
+func (c *Conn) buildTypedRequestForWrite(req *attemptRequest, stream int) (wire.Chain, *smallTypedFrame, error) {
+	settings := c.nativeProtocol()
+	if _, ok := settings.SmallTypedRequestSize(req, 256); !ok {
+		packet, err := settings.BuildTypedRequest(req, stream)
+		return packet, nil, err
+	}
+	scratch := acquireSmallTypedFrame()
+	packet, err := settings.BuildSmallTypedRequest(req, stream, scratch.data[:0])
+	if err != nil {
+		releaseSmallTypedFrame(scratch)
+		return wire.Chain{}, nil, err
+	}
+	return packet, scratch, nil
+}
+func writeTypedRequestPacket(ctx context.Context, writer spanContextWriter, packet wire.Chain, scratch *smallTypedFrame) (int64, error) {
+	// InternalWriteSpans joins accepted/coalesced writes on all exits, including
+	// cancellation and partial I/O. Only this completion permits reuse.
+	defer releaseSmallTypedFrame(scratch)
+	return writer.InternalWriteSpans(ctx, packet)
+}

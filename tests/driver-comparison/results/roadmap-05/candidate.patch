+func TestSmallFrameCoalescerCancellationKeepsAcceptedScratch(t *testing.T) {
+	emptySmallFramePool()
+	defer emptySmallFramePool()
+	packet, scratch, expected := newSmallFramePacket(t)
+	quit := make(chan struct{})
+	timer := make(chan time.Time, 1)
+	admitted := make(chan struct{})
+	sink := &scratchTestWriter{}
+	writer := &InternalWriteCoalescer{InternalC: sink, InternalQuit: quit, InternalWriteCh: make(chan InternalWriteRequest), InternalTestEnqueuedHook: func() { close(admitted) }}
+	flusherDone := make(chan struct{})
+	go func() { defer close(flusherDone); writer.InternalWriteFlusherImpl(timer, func() {}) }()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, err := writeTypedRequestPacket(ctx, writer, packet, scratch); done <- err }()
+	<-admitted
+	cancel()
+	select {
+	case <-done:
+		t.Fatal("cancelled coalescer released accepted scratch")
+	default:
+	}
+	current := make([]byte, packet.Len())
+	_, _ = packet.CopyTo(current)
+	if len(smallTypedFrames) != 0 || !bytes.Equal(current, expected) {
+		t.Fatal("pending coalesced scratch changed")
+	}
+	timer <- time.Now()
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(sink.Bytes(), expected) {
+		t.Fatal("coalescer changed accepted frame")
+	}
+	close(quit)
+	<-flusherDone
+	if len(smallTypedFrames) != 1 {
+		t.Fatal("coalesced completion did not recycle scratch")
+	}
+}

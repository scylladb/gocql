@@ -0,0 +1,119 @@
+// Copyright 2026 The Gocql Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+
+package codec
+
+import (
+	"testing"
+
+	"github.com/scylladb/gocql/v2/internal/cqltype"
+	"github.com/scylladb/gocql/v2/internal/model"
+	"github.com/scylladb/gocql/v2/internal/wire"
+)
+
+func TestParamCaptureRollbackAndNestedPair(t *testing.T) {
+	typ := rowTestType(t, cqltype.TypeInt)
+	cols := cqltype.NewColumns(cqltype.ColumnSpec{Name: "a", Type: typ}, cqltype.ColumnSpec{Name: "b", Type: typ}, cqltype.ColumnSpec{Name: "c", Type: typ})
+	good := PairParams(1, OneParam(Int32), PairParams(1, OneParam(Int32), OneParam(Int32)))
+	bad := PairParams(1, OneParam(Int32), PairParams(1, OneParam(Int32), OneParam[int32](failingRowEncoder{})))
+	value := Pair[int32, Pair[int32, int32]]{First: 11, Second: Pair[int32, int32]{First: 22, Second: 33}}
+	badplan, err := bad.Compile(cols)
+	if err != nil {
+		t.Fatal(err)
+	}
+	goodplan, err := good.Compile(cols)
+	if err != nil {
+		t.Fatal(err)
+	}
+	builder := wire.NewBuilder(4)
+	w := NewParamWriter(builder, cols, true)
+	CaptureParamCells(w, make([]model.EncodedCell, 0, 3))
+	if err := badplan.Encode(w, value); err == nil {
+		t.Fatal("expected failing custom encoder")
+	}
+	if builder.Len() != 0 || w.index != 0 || len(w.cells) != 0 {
+		t.Fatalf("rollback left bytes/index/cells %d/%d/%d", builder.Len(), w.index, len(w.cells))
+	}
+	if err := goodplan.Encode(w, value); err != nil {
+		t.Fatal(err)
+	}
+	if err := FinishParamWriter(w); err != nil {
+		t.Fatal(err)
+	}
+	framed, err := builder.Freeze()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cells, err := CapturedParamCells(w, framed)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(cells) != 3 {
+		t.Fatalf("captured %d cells", len(cells))
+	}
+	for i, v := range []uint32{11, 22, 33} {
+		if cells[i].BodyOffset != int64(i*8+4) || cells[i].State != cqltype.Present {
+			t.Fatalf("cell %d: %+v", i, cells[i])
+		}
+		cursor := wire.NewCursor(cells[i].Body)
+		n, err := cursor.Uint32()
+		if err != nil || n != v {
+			t.Fatalf("cell %d: value=%d err=%v", i, n, err)
+		}
+	}
+}
+
+func TestParamCaptureCustomCellFailureCanRetry(t *testing.T) {
+	typ := rowTestType(t, cqltype.TypeInt)
+	cols := cqltype.NewColumns(cqltype.ColumnSpec{Name: "a", Type: typ})
+	builder := wire.NewBuilder(4)
+	w := NewParamWriter(builder, cols, true)
+	CaptureParamCells(w, make([]model.EncodedCell, 0, 1))
+	if err := WriteParam(w, failingRowEncoder{}, int32(7)); err == nil {
+		t.Fatal("expected failing encoder")
+	}
+	if len(w.cells) != 0 || w.index != 0 || builder.Len() != 0 {
+		t.Fatal("failed cell was captured")
+	}
+	if err := WriteParam(w, Int32, int32(9)); err != nil {
+		t.Fatal(err)
+	}
+	framed, err := builder.Freeze()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cells, err := CapturedParamCells(w, framed)
+	if err != nil || len(cells) != 1 || cells[0].BodyOffset != 4 {
+		t.Fatalf("capture=%+v err=%v", cells, err)
+	}
+}
+
+func TestParamCaptureDynamicPlanRollback(t *testing.T) {
+	typ := rowTestType(t, cqltype.TypeInt)
+	cols := cqltype.NewColumns(cqltype.ColumnSpec{Name: "a", Type: typ}, cqltype.ColumnSpec{Name: "b", Type: typ})
+	for _, named := range []bool{false, true} {
+		builder := wire.NewBuilder(4)
+		w := NewParamWriter(builder, cols, false)
+		CaptureParamCells(w, make([]model.EncodedCell, 0, 2))
+		if named {
+			plan, err := NamedDynamicParams.Compile(cols)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := plan.Encode(w, []ValueField{{Name: "a", Value: IntValue(3)}, {Name: "b", Value: UnsetDynamic(typ)}}); err == nil {
+				t.Fatal("expected unset rejection")
+			}
+		} else {
+			plan, err := DynamicParams.Compile(cols)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := plan.Encode(w, []Value{IntValue(3), UnsetDynamic(typ)}); err == nil {
+				t.Fatal("expected unset rejection")
+			}
+		}
+		if builder.Len() != 0 || w.index != 0 || len(w.cells) != 0 {
+			t.Fatalf("dynamic rollback left %d/%d/%d", builder.Len(), w.index, len(w.cells))
+		}
+	}
+}

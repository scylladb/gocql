index 0000000..ebdfa8b
--- /dev/null
+++ b/internal/binding/param_capture_test.go
@@ -0,0 +1,160 @@
+// Copyright 2026 The Gocql Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+
+package binding
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/scylladb/gocql/v2/internal/codec"
+	"github.com/scylladb/gocql/v2/internal/cqltype"
+	"github.com/scylladb/gocql/v2/internal/wire"
+)
+
+func paramCaptureType(t testing.TB, kind cqltype.Type) cqltype.DataType {
+	t.Helper()
+	typ, err := cqltype.ScalarType(kind)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return typ
+}
+
+// reparsedParameters retains the previous two-pass implementation as an oracle.
+func reparsedParameters[P any](plan ParamPlan[P], columns Columns, value P, owned, allowUnset bool) (encodedValues, error) {
+	b := wire.NewBuilder(256)
+	w := codec.NewParamWriter(b, columns, allowUnset)
+	codec.SetParamOwnership(w, owned)
+	if err := plan.Encode(w, value); err != nil {
+		return encodedValues{}, err
+	}
+	if err := codec.FinishParamWriter(w); err != nil {
+		return encodedValues{}, err
+	}
+	framed, err := b.Freeze()
+	if err != nil {
+		return encodedValues{}, err
+	}
+	cursor := wire.NewCursor(framed)
+	cells := make([]encodedCell, columns.Len())
+	for i := range cells {
+		col, _ := columns.At(i)
+		v, err := codec.ReadValue(cursor, col.Type, nil, allowUnset)
+		if err != nil {
+			return encodedValues{}, err
+		}
+		cells[i].State, cells[i].Body = v.State(), cqltype.BytesChain(v.Bytes())
+	}
+	if err := cursor.RequireEnd(); err != nil {
+		return encodedValues{}, err
+	}
+	return encodedValues{Columns: columns, Cells: cells, Framed: framed}, nil
+}
+
+func captureBytes(chain wire.Chain) []byte {
+	var b []byte
+	_ = chain.Each(func(s wire.Span) error { b = append(b, s.Bytes()...); return nil })
+	return b
+}
+
+func TestCapturedParametersMatchReparse(t *testing.T) {
+	integer, blob := paramCaptureType(t, cqltype.TypeInt), paramCaptureType(t, cqltype.TypeBlob)
+	columns := cqltype.NewColumns(cqltype.ColumnSpec{Name: "key", Type: integer}, cqltype.ColumnSpec{Name: "blob", Type: blob}, cqltype.ColumnSpec{Name: "null", Type: integer}, cqltype.ColumnSpec{Name: "unset", Type: integer}, cqltype.ColumnSpec{Name: "empty", Type: integer})
+	empty, err := codec.EmptyValue(integer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	input := []codec.Value{codec.IntValue(17), codec.BlobValue([]byte("payload")), codec.NullValue(integer), codec.UnsetDynamic(integer), empty}
+	plan, err := codec.DynamicParams.Compile(columns)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, owned := range []bool{false, true} {
+		got, err := InternalEncodeParameters(plan, columns, input, owned, true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		want, err := reparsedParameters(plan, columns, input, owned, true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(captureBytes(got.Framed), captureBytes(want.Framed)) {
+			t.Fatal("framing differs")
+		}
+		for i := range got.Cells {
+			if got.Cells[i].State != want.Cells[i].State || !bytes.Equal(captureBytes(got.Cells[i].Body), captureBytes(want.Cells[i].Body)) {
+				t.Fatalf("cell %d differs", i)
+			}
+		}
+	}
+	if _, err := InternalEncodeParameters(plan, columns, input, false, false); err == nil {
+		t.Fatal("v3 unset accepted")
+	}
+}
+
+func TestCapturedParametersBorrowedAndOwned(t *testing.T) {
+	columns := cqltype.NewColumns(cqltype.ColumnSpec{Name: "blob", Type: paramCaptureType(t, cqltype.TypeBlob)})
+	plan, err := codec.OneParam(codec.BytesEncoder).Compile(columns)
+	if err != nil {
+		t.Fatal(err)
+	}
+	input := []byte("payload")
+	borrowed, err := InternalEncodeParameters(plan, columns, input, false, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	owned, err := InternalEncodeParameters(plan, columns, input, true, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	input[0] = 'X'
+	if string(captureBytes(borrowed.Cells[0].Body)) != "Xayload" || string(captureBytes(owned.Cells[0].Body)) != "payload" {
+		t.Fatal("ownership changed")
+	}
+}
+
+func BenchmarkCapturedParameters(b *testing.B) {
+	integer, blob := paramCaptureType(b, cqltype.TypeInt), paramCaptureType(b, cqltype.TypeBlob)
+	type input struct {
+		K, R int32
+		P    []byte
+	}
+	for _, write := range []bool{false, true} {
+		columns := cqltype.NewColumns(cqltype.ColumnSpec{Name: "k", Type: integer})
+		var encoder codec.ParamEncoder[input] = codec.Params(codec.Param("k", codec.Int32, func(v input) int32 { return v.K }))
+		name := "point-read"
+		if write {
+			columns = cqltype.NewColumns(cqltype.ColumnSpec{Name: "k", Type: integer}, cqltype.ColumnSpec{Name: "r", Type: integer}, cqltype.ColumnSpec{Name: "p", Type: blob})
+			encoder = codec.Params(codec.Param("k", codec.Int32, func(v input) int32 { return v.K }), codec.Param("r", codec.Int32, func(v input) int32 { return v.R }), codec.Param("p", codec.BytesEncoder, func(v input) []byte { return v.P }))
+			name = "point-write"
+		}
+		plan, err := encoder.Compile(columns)
+		if err != nil {
+			b.Fatal(err)
+		}
+		value := input{K: 17, R: 1, P: make([]byte, 1024)}
+		b.Run(name, func(b *testing.B) {
+			for _, capture := range []bool{false, true} {
+				sub := "reparse"
+				if capture {
+					sub = "capture"
+				}
+				b.Run(sub, func(b *testing.B) {
+					b.ReportAllocs()
+					for i := 0; i < b.N; i++ {
+						var err error
+						if capture {
+							_, err = InternalEncodeParameters(plan, columns, value, false, true)
+						} else {
+							_, err = reparsedParameters(plan, columns, value, false, true)
+						}
+						if err != nil {
+							b.Fatal(err)
+						}
+					}
+				})
+			}
+		})
+	}
+}

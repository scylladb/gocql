@@ -0,0 +1,296 @@
+// Copyright 2026 The Gocql Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+
+package transport
+
+import (
+	"bytes"
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"io"
+	"math/big"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/scylladb/gocql/v2/internal/cqltype"
+	"github.com/scylladb/gocql/v2/internal/model"
+	"github.com/scylladb/gocql/v2/internal/wire"
+)
+
+func emptySmallFramePool() {
+	for {
+		select {
+		case <-smallTypedFrames:
+		default:
+			return
+		}
+	}
+}
+func newSmallFramePacket(t *testing.T) (wire.Chain, *smallTypedFrame, []byte) {
+	t.Helper()
+	c := &Conn{InternalVersion: 4}
+	req := &model.AttemptRequest{PreparedID: []byte("prepared"), Consistency: cqltype.One, SkipMetadata: true}
+	packet, scratch, err := c.buildTypedRequestForWrite(req, 3)
+	if err != nil || scratch == nil {
+		t.Fatalf("small frame: scratch=%p error=%v", scratch, err)
+	}
+	expected := make([]byte, packet.Len())
+	_, _ = packet.CopyTo(expected)
+	return packet, scratch, expected
+}
+
+type blockedSmallFrameWriter struct {
+	entered, release chan struct{}
+	got              []byte
+}
+
+func (w *blockedSmallFrameWriter) InternalWriteSpans(_ context.Context, c wire.Chain) (int64, error) {
+	close(w.entered)
+	<-w.release
+	w.got = make([]byte, c.Len())
+	_, err := c.CopyTo(w.got)
+	return c.Len(), err
+}
+
+func TestSmallFrameScratchWaitsForAcceptedWriter(t *testing.T) {
+	emptySmallFramePool()
+	defer emptySmallFramePool()
+	packet, scratch, expected := newSmallFramePacket(t)
+	sink := &blockedSmallFrameWriter{entered: make(chan struct{}), release: make(chan struct{})}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, err := writeTypedRequestPacket(ctx, sink, packet, scratch); done <- err }()
+	<-sink.entered
+	cancel()
+	select {
+	case <-done:
+		t.Fatal("accepted write returned before completion")
+	default:
+	}
+	if len(smallTypedFrames) != 0 {
+		t.Fatal("in-flight frame returned to pool")
+	}
+	other := acquireSmallTypedFrame()
+	if other == scratch {
+		t.Fatal("in-flight scratch reused")
+	}
+	if !bytes.Equal(scratch.data[:len(expected)], expected) {
+		t.Fatal("cancellation changed accepted bytes")
+	}
+	close(sink.release)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(sink.got, expected) {
+		t.Fatal("accepted writer saw changed bytes")
+	}
+	if len(smallTypedFrames) != 1 {
+		t.Fatal("completed frame not returned")
+	}
+	for _, v := range scratch.data {
+		if v != 0 {
+			t.Fatal("idle pool retains request bytes")
+		}
+	}
+	releaseSmallTypedFrame(other)
+}
+
+func TestSmallFrameScratchAllWriterExitsAndBound(t *testing.T) {
+	for _, outcome := range []string{"success", "short", "error", "panic", "cancelled"} {
+		t.Run(outcome, func(t *testing.T) {
+			emptySmallFramePool()
+			defer emptySmallFramePool()
+			packet, scratch, expected := newSmallFramePacket(t)
+			sink := &scratchTestWriter{outcome: outcome}
+			writer := &InternalDeadlineContextWriter{InternalW: sink, InternalSemaphore: make(chan struct{}, 1), InternalQuit: make(chan struct{})}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if outcome == "cancelled" {
+				cancel()
+			}
+			var err error
+			var caught any
+			func() {
+				defer func() { caught = recover() }()
+				_, err = writeTypedRequestPacket(ctx, writer, packet, scratch)
+			}()
+			switch outcome {
+			case "success":
+				if err != nil || !bytes.Equal(sink.Bytes(), expected) {
+					t.Fatalf("write: %v", err)
+				}
+			case "short":
+				if !errors.Is(err, io.ErrShortWrite) {
+					t.Fatal(err)
+				}
+			case "error":
+				if !errors.Is(err, io.ErrClosedPipe) {
+					t.Fatal(err)
+				}
+			case "panic":
+				if caught == nil {
+					t.Fatal("panic lost")
+				}
+			case "cancelled":
+				if !errors.Is(err, context.Canceled) || sink.Len() != 0 {
+					t.Fatal("cancelled write reached sink")
+				}
+			}
+			if len(smallTypedFrames) != 1 {
+				t.Fatal("scratch not released")
+			}
+		})
+	}
+	emptySmallFramePool()
+	defer emptySmallFramePool()
+	for range 80 {
+		releaseSmallTypedFrame(new(smallTypedFrame))
+	}
+	if len(smallTypedFrames) != 64 {
+		t.Fatal("idle pool exceeds declared bound")
+	}
+}
+
+func TestSmallFrameTLSWrite(t *testing.T) {
+	emptySmallFramePool()
+	defer emptySmallFramePool()
+	packet, scratch, expected := newSmallFramePacket(t)
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{SerialNumber: big.NewInt(1), DNSNames: []string{"scratch.test"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cert, err := x509.ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	roots := x509.NewCertPool()
+	roots.AddCert(cert)
+	rawClient, rawServer := net.Pipe()
+	defer rawClient.Close()
+	defer rawServer.Close()
+	server := tls.Server(rawServer, &tls.Config{Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: key}}, MinVersion: tls.VersionTLS13})
+	client := tls.Client(rawClient, &tls.Config{RootCAs: roots, ServerName: "scratch.test", MinVersion: tls.VersionTLS13})
+	done := make(chan error, 1)
+	go func() {
+		data := make([]byte, len(expected))
+		_, err := io.ReadFull(server, data)
+		if err == nil && !bytes.Equal(data, expected) {
+			err = fmt.Errorf("TLS changed frame")
+		}
+		done <- err
+	}()
+	writer := &InternalDeadlineContextWriter{InternalW: client, InternalSemaphore: make(chan struct{}, 1), InternalQuit: make(chan struct{})}
+	writer.InternalSetWriteTimeout(time.Second * 5)
+	if _, err := writeTypedRequestPacket(context.Background(), writer, packet, scratch); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if len(smallTypedFrames) != 1 {
+		t.Fatal("TLS completion did not release scratch")
+	}
+}

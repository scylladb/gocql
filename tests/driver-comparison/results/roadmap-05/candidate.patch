+func TestSmallFrameLargeRequestKeepsBorrowedPayload(t *testing.T) {
+	c := &Conn{InternalVersion: 4}
+	payload := bytes.Repeat([]byte{7}, 1024)
+	values := scratchTestChain(t, []byte{0, 0, 4, 0}, payload)
+	packet, scratch, err := c.buildTypedRequestForWrite(&model.AttemptRequest{PreparedID: []byte("prepared"), Consistency: cqltype.One, Values: values, ValueCount: 1}, 2)
+	if err != nil || scratch != nil {
+		t.Fatalf("large request scratch=%p err=%v", scratch, err)
+	}
+	found := false
+	_ = packet.Each(func(s wire.Span) error {
+		if len(s.Bytes()) == len(payload) && &s.Bytes()[0] == &payload[0] {
+			found = true
+		}
+		return nil
+	})
+	if !found {
+		t.Fatal("large request gathered borrowed payload")
+	}
+}

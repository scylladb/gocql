    "behavior_test_source": "package contracts\n\nimport (\n\t\"errors\"\n\t\"github.com/scylladb/gocql/v2\"\n\t\"net/netip\"\n\t\"testing\"\n)\n\ntype statefulConviction struct{ failures map[gocql.UUID]int }\n\nfunc (p *statefulConviction) AddFailure(_ error, host gocql.HostSnapshot) bool {\n\tp.failures[host.ID]++\n\treturn p.failures[host.ID] >= 2\n}\nfunc (p *statefulConviction) Reset(host gocql.HostSnapshot) { delete(p.failures, host.ID) }\nfunc TestExternalConvictionImplementation(t *testing.T) {\n\tpolicy := &statefulConviction{failures: map[gocql.UUID]int{}}\n\tconfig := gocql.DefaultConfig(\"127.0.0.1\")\n\tconfig.Conviction = policy\n\thost := gocql.HostSnapshot{ID: gocql.ParseUUIDMust(\"ed8ea335-19d6-4652-9d9a-4519c3b6eff0\"), Address: netip.MustParseAddrPort(\"127.0.0.1:9042\"), Datacenter: \"dc1\", Rack: \"r1\", Tokens: []int64{-1, 1}, Enabled: true, Up: true}\n\tfailure := errors.New(\"external failure\")\n\tif config.Conviction.AddFailure(failure, host) || !config.Conviction.AddFailure(failure, host) {\n\t\tt.Fatal(\"stateful conviction decision\")\n\t}\n\tconfig.Conviction.Reset(host)\n\tif config.Conviction.AddFailure(failure, host) {\n\t\tt.Fatal(\"reset did not clear the selected host\")\n\t}\n\tvar simple gocql.ConvictionPolicy = &gocql.SimpleConvictionPolicy{}\n\tif !simple.AddFailure(failure, host) {\n\t\tt.Fatal(\"simple conviction behavior changed\")\n\t}\n\tsimple.Reset(host)\n\tif !simple.AddFailure(failure, host) {\n\t\tt.Fatal(\"simple reset behavior changed\")\n\t}\n}\n",

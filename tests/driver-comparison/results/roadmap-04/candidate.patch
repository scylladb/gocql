+
+// CaptureParamCells supplies the final cell storage before encoding starts.
+// Successful WriteParam calls append boundaries; plan rollback removes them.
+func CaptureParamCells(w *ParamWriter, cells []model.EncodedCell) { w.cells = cells[:0] }
+
+func (w *ParamWriter) rollbackCells(n int) {
+	clear(w.cells[n:])
+	w.cells = w.cells[:n]
+}
+
+// CapturedParamCells completes body views from already checked cell boundaries.
+// It neither reparses cell prefixes nor repeats codec/type validation.
+func CapturedParamCells(w *ParamWriter, framed wire.Chain) ([]model.EncodedCell, error) {
+	for i := range w.cells {
+		end := framed.Len()
+		if i+1 < len(w.cells) {
+			end = w.cells[i+1].BodyOffset - 4
+		}
+		body, err := framed.Slice(w.cells[i].BodyOffset, end-w.cells[i].BodyOffset)
+		if err != nil {
+			return nil, err
+		}
+		w.cells[i].Body = body
+	}
+	return w.cells, nil
+}

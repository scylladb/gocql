+// Copyright 2026 The Gocql Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+
+package protocol
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"testing"
+
+	"github.com/scylladb/gocql/v2/internal/cqltype"
+	"github.com/scylladb/gocql/v2/internal/model"
+	"github.com/scylladb/gocql/v2/internal/wire"
+)
+
+func TestSmallTypedRequestMatchesSegmented(t *testing.T) {
+	for _, version := range []byte{3, 4} {
+		for mask := 0; mask < 128; mask++ {
+			settings := protocolSettings(version)
+			settings.MetadataID = mask&1 != 0
+			settings.TabletsRoutingV2 = mask&2 != 0
+			settings.Flags = 0xff
+			values := binary.BigEndian.AppendUint32(nil, 4)
+			values = binary.BigEndian.AppendUint32(values, 1234)
+			values = binary.BigEndian.AppendUint32(values, 0xffffffff)
+			req := &model.AttemptRequest{PreparedID: []byte("prepared"), ResultMetadataID: []byte("metadata"), Values: typedTestChain(t, values[:3], values[3:9], values[9:]), ValueCount: 2, Consistency: cqltype.LocalQuorum, TabletVersionBlock: 19, Trace: mask&4 != 0, SkipMetadata: mask&8 != 0}
+			if mask&16 != 0 {
+				req.PageSize = 32
+				req.PagingState = []byte{}
+			}
+			if mask&32 != 0 {
+				req.SerialConsistency = cqltype.LocalSerial
+				req.PagingState = []byte("page")
+			}
+			if mask&64 != 0 {
+				req.DefaultTimestamp = true
+				req.Timestamp = -9
+			}
+			expected, err := settings.BuildTypedRequest(req, 317)
+			if err != nil {
+				t.Fatal(err)
+			}
+			size, ok := settings.SmallTypedRequestSize(req, 256)
+			if !ok {
+				t.Fatalf("version=%d mask=%d unexpectedly excluded", version, mask)
+			}
+			scratch := make([]byte, 256)
+			got, err := settings.BuildSmallTypedRequest(req, 317, scratch[:0])
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := typedTestBytes(t, expected)
+			if got.Len() != int64(size) || !bytes.Equal(typedTestBytes(t, got), want) {
+				t.Fatalf("version=%d mask=%d mismatch", version, mask)
+			}
+			if size, ok := settings.SmallTypedRequestSize(req, len(want)-1); ok {
+				t.Fatalf("size %d admitted past cap", size)
+			}
+			settings.MaxFrameBytes = int64(size - HeadSize - 1)
+			if _, err := settings.BuildSmallTypedRequest(req, 317, scratch[:0]); !errors.Is(err, ErrFrameTooBig) {
+				t.Fatalf("body limit: %v", err)
+			}
+		}
+	}
+}
+
+func TestSmallTypedRequestRetainsValidationAndFallback(t *testing.T) {
+	settings := protocolSettings(4)
+	valid := &model.AttemptRequest{PreparedID: []byte{1}, Consistency: cqltype.One}
+	for _, mutate := range []func(*model.AttemptRequest){
+		func(r *model.AttemptRequest) { r.Values = typedTestChain(t, []byte{0}); r.ValueCount = 1 },
+		func(r *model.AttemptRequest) {
+			r.Values = typedTestChain(t, []byte{0xff, 0xff, 0xff, 0xfd})
+			r.ValueCount = 1
+		},
+		func(r *model.AttemptRequest) { r.ValueCount = 1 },
+		func(r *model.AttemptRequest) { r.Values = typedTestChain(t, []byte{0}); r.ValueCount = 0 },
+	} {
+		req := *valid
+		mutate(&req)
+		_, want := settings.BuildTypedRequest(&req, 1)
+		_, got := settings.BuildSmallTypedRequest(&req, 1, make([]byte, 0, 256))
+		if want == nil || got == nil || want.Error() != got.Error() {
+			t.Fatalf("validation = %v, canonical = %v", got, want)
+		}
+	}
+	unset := *valid
+	unset.ValueCount = 1
+	unset.Values = typedTestChain(t, []byte{0xff, 0xff, 0xff, 0xfe})
+	settings.Protocol = 3
+	if _, err := settings.BuildSmallTypedRequest(&unset, 1, make([]byte, 0, 256)); err == nil {
+		t.Fatal("v3 admitted unset")
+	}
+	settings.Protocol = 4
+	if _, err := settings.BuildSmallTypedRequest(&unset, 1, make([]byte, 0, 256)); err != nil {
+		t.Fatal(err)
+	}
+	for _, mutate := range []func(*model.AttemptRequest){
+		func(r *model.AttemptRequest) { r.PreparedID = nil; r.Statement = "SELECT now() FROM system.local" },
+		func(r *model.AttemptRequest) { r.PreparedID = make([]byte, 257) },
+		func(r *model.AttemptRequest) { r.PageSize = -1 },
+		func(r *model.AttemptRequest) { r.Prepare = true },
+		func(r *model.AttemptRequest) { r.Keyspace = "ks" },
+	} {
+		req := *valid
+		mutate(&req)
+		if _, ok := settings.SmallTypedRequestSize(&req, 256); ok {
+			t.Fatal("complex/invalid request admitted")
+		}
+		got, gotErr := settings.BuildSmallTypedRequest(&req, 1, make([]byte, 0, 256))
+		want, wantErr := settings.BuildTypedRequest(&req, 1)
+		if (gotErr == nil) != (wantErr == nil) {
+			t.Fatalf("fallback error %v vs %v", gotErr, wantErr)
+		}
+		if gotErr == nil && !bytes.Equal(typedTestBytes(t, got), typedTestBytes(t, want)) {
+			t.Fatal("fallback changed bytes")
+		}
+	}
+}
+
+var scratchBenchChain wire.Chain
+
+func BenchmarkSmallTypedRequestEncoding(b *testing.B) {
+	settings := protocolSettings(4)
+	values, _ := wire.NewChain(wire.Borrow([]byte{0, 0, 0, 4, 0, 0, 0, 1}))
+	req := &model.AttemptRequest{PreparedID: []byte("0123456789abcdef"), Values: values, ValueCount: 1, Consistency: cqltype.LocalQuorum, SkipMetadata: true, PageSize: 32}
+	b.Run("segmented", func(b *testing.B) {
+		b.ReportAllocs()
+		for range b.N {
+			var err error
+			scratchBenchChain, err = settings.BuildTypedRequest(req, 1)
+			if err != nil {
+				b.Fatal(err)
+			}
+		}
+	})
+	b.Run("scratch", func(b *testing.B) {
+		buf := make([]byte, 256)
+		b.ReportAllocs()
+		b.ResetTimer()
+		for range b.N {
+			var err error
+			scratchBenchChain, err = settings.BuildSmallTypedRequest(req, 1, buf[:0])
+			if err != nil {
+				b.Fatal(err)
+			}
+		}
+	})
+}
diff --git a/internal/transport/v2_request_scratch.go b/internal/transport/v2_request_scratch.go
